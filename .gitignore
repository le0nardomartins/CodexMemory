# =============================================================================
# CodexMemory — .gitignore
# Regra geral: apenas código-fonte, assets e docs vão para o repositório.
# Tudo gerado por runtime, AI, daemons ou específico da máquina local é local-only.
# =============================================================================


# -----------------------------------------------------------------------------
# AI / Sistema — conteúdo gerado em runtime, NUNCA commitado
# -----------------------------------------------------------------------------

# Memória consolidada gerada pelo agente (saída do motor ollama/algorithm)
memory_voult/AGENT_MEMORY.md

# Contextos individuais criados pela AI — todos local-only
# (context_1.md é mantido por humano mas também fica local por segurança)
memory_voult/context/*.md

# Snapshots versionados do AGENT_MEMORY.md gerados automaticamente
memory_voult/snapshots/*.md

# Logs internos do sistema de memória
memory_voult/logs/
memory_voult/**/*.log

# Arquivos de estado de runtime (JSON ocultos gerados pelo server.js)
memory_voult/.*.json

# Enumerados explicitamente como redundância de segurança:
memory_voult/.sync_state.json
memory_voult/.context_state.json
memory_voult/.canonical_state.json
memory_voult/.neuron_graph_snapshot.json
memory_voult/.compressed_context_state.json


# -----------------------------------------------------------------------------
# Configuração local do usuário (específica de cada máquina)
# -----------------------------------------------------------------------------

# Caminhos absolutos da máquina — gerado a partir de config/ai_paths.json.example
config/ai_paths.json


# -----------------------------------------------------------------------------
# Build, empacotamento e dependências
# -----------------------------------------------------------------------------

node_modules/
dist/
build/
out/
.webpack/
*.egg-info/
.eggs/
pip-wheel-metadata/


# -----------------------------------------------------------------------------
# Logs e runtime
# -----------------------------------------------------------------------------

*.log
*.pid
*.out
desktop_boot.log
logs/

# -----------------------------------------------------------------------------
# Secrets e variáveis de ambiente
# -----------------------------------------------------------------------------

.env
.env.*
*.local
*.pem
*.key
*.secret
secrets/
credentials/


# -----------------------------------------------------------------------------
# IDE e editores
# -----------------------------------------------------------------------------

.vscode/
.idea/
*.suo
*.user
*.userossc
*.swp
*.swo
*.orig


# -----------------------------------------------------------------------------
# Sistema operacional
# -----------------------------------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# Temporários
# -----------------------------------------------------------------------------

*.tmp
*.temp
*.bak
~$*
