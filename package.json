{
  "name": "codexmemory",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop memory server + daemon + GUI for CodexMemory",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "daemon": "node server.js --mode daemon",
    "daemon:once": "node server.js --mode daemon --once",
    "gui": "node server.js --mode gui",
    "test:memory": "node --test tests/memory-regression.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^41.5.0"
  }
}
