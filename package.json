{
  "name": "codexmemory",
  "version": "2.0.0",
  "private": true,
  "description": "MCP memory server + daemon + GUI for CodexMemory",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "mcp": "node server.js --mode mcp",
    "daemon": "node server.js --mode daemon",
    "daemon:once": "node server.js --mode daemon --once",
    "gui": "node server.js --mode gui"
  },
  "engines": {
    "node": ">=18"
  }
}
